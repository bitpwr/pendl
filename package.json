{
  "name": "pendl",
  "version": "0.1.2",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "test": "vitest",
    "test:run": "vitest run",
    "gtfs:import": "npx tsx scripts/import-gtfs.ts",
    "gtfs:realtime": "npx tsx scripts/realtime-worker.ts",
    "format": "npx prettier --write \"src/**/*.{ts,tsx}\" \"scripts/**/*.ts\"",
    "changelog": "bash scripts/generate-changelog.sh",
    "preversion": "npm run build && npm run lint && npm test",
    "version": "bash scripts/generate-changelog.sh $npm_package_version && git add CHANGELOG.md",
    "pushversion": "git push && git push --tags",
    "release:patch": "npm version patch -m 'Release v%s'",
    "release:minor": "npm version minor -m 'Release v%s'",
    "release:major": "npm version major -m 'Release v%s'",
    "release:prerelease": "npm version prerelease --preid=rc -m 'Release v%s'"
  },
  "dependencies": {
    "@radix-ui/react-slot": "^1.2.4",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "csv-parse": "^6.1.0",
    "ioredis": "^5.9.2",
    "leaflet": "^1.9.4",
    "lucide-react": "^0.563.0",
    "next": "16.1.5",
    "node-fetch": "^3.3.2",
    "pg": "^8.17.2",
    "protobufjs": "^8.0.0",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-leaflet": "^5.0.0",
    "tailwind-merge": "^3.4.0",
    "unzipper": "^0.12.3"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16",
    "@types/leaflet": "^1.9.21",
    "@types/node": "^20",
    "@types/pg": "^8.16.0",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/unzipper": "^0.10.11",
    "@vitejs/plugin-react": "^4",
    "eslint": "^9",
    "eslint-config-next": "16.1.5",
    "jsdom": "^26",
    "tailwindcss": "^4",
    "tsx": "^4.21.0",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5",
    "vitest": "^3"
  }
}
